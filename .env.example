# Local e2e sign-in email: Mailpit from docker-compose (`docker compose up -d mail`).
# Without these two, NextAuth's Email provider has no SMTP and every sign-in e2e
# test fails with "No sign-in email received" — even though the recipe looks complete.
AUTH_EMAIL_SERVER="smtp://localhost:1025"
AUTH_EMAIL_FROM="assay@localhost"

# 网页的第二扇门（ADR-0035）：一次性配对码。**默认关闭**是决策本身，不是疏漏——
# 它只在实例本机（loopback）可兑换，且不得由 NODE_ENV 推断（内网主机上跑
# `next dev` 时那等于给一台服务家人的机器开后门）。
# 打开后：npm run --silent agent -- issue-pairing-code → 在本机浏览器打开 /pair 填码。
# ASSAY_ENABLE_PAIRING_LOGIN=1

# 身份也可以从文件读（ADR-0036）：秘密不进 shell 历史，也不出现在 `ps` 里。
# 文件里只放一把钥匙（末尾换行无所谓）。优先级低于 ASSAY_AGENT_API_KEY，
# 高于遗留的 ASSAY_AGENT_USER_EMAIL。
# ASSAY_AGENT_API_KEY_FILE=/run/secrets/assay-agent-key
