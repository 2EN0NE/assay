generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum QuestionType {
  BINARY
  MULTIPLE_CHOICE
  QUANTITY
}

model Workspace {
  teamId    String   @id @unique
  teamName  String
  token     String
  createdAt DateTime @default(now())
}

model Forecast {
  id         Int              @id @default(autoincrement())
  createdAt  DateTime         @default(now())
  comment    String?
  forecast   Decimal
  profileId  Int?
  questionId String
  provenance RecordProvenance @default(HUMAN)
  endorsed   Boolean          @default(true)
  endorsedAt DateTime?
  // 审计线索（ADR-0027）：只存标识，不存会话正文。发起方类别与声明分开存——
  // "agent 发起的调用"与"这个数字是当事人给的"是两件事，合在一就会丢掉可对质的
  // 能力：恰恰是“来自会话却自称数字由当事人给出”这类记录最需要被筛出来。
  initiator      InitiatorKind @default(HUMAN)
  agentSessionId String?
  optionId   String?
  option     QuestionOption?  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId     String
  profile    Profile?         @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "Forecast_authorId_fkey")
  question   Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuestionScore {
  id                  Int             @id @default(autoincrement())
  createdAt           DateTime        @default(now())
  relativeScore       Decimal?
  questionId          String
  userQuestionComboId String          @unique // on questions, this is userid + questionid, on options this is userid + optionid
  absoluteScore       Decimal
  rank                Int
  userId              String
  question            Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  QuestionOption      QuestionOption? @relation(fields: [questionOptionId], references: [id])
  questionOptionId    String?
}

model QuestionOption {
  id             String          @id @default(cuid())
  questionId     String
  text           String
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  forecasts      Forecast[]
  resolution     Resolution?
  createdAt      DateTime        @default(now())
  user           User            @relation("author", fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  resolvedAt     DateTime?
  questionScores QuestionScore[]
}

model Question {
  id                           String                   @id @default(cuid())
  createdAt                    DateTime                 @default(now())
  comment                      String? // todo remove, unused
  profileId                    Int?
  title                        String                   @db.Text
  type                         QuestionType             @default(BINARY)
  options                      QuestionOption[]
  resolveBy                    DateTime
  resolved                     Boolean                  @default(false)
  pingedForResolution          Boolean                  @default(false)
  resolution                   Resolution?
  resolvedAt                   DateTime?
  notes                        String?
  hideForecastsUntil           DateTime?
  hideForecastsUntilPrediction Boolean?                 @default(false)
  userId                       String
  forecasts                    Forecast[]
  pingResolveMessages          PingSlackMessage[]
  profile                      Profile?                 @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "Question_authorId_fkey")
  user                         User                     @relation("author", fields: [userId], references: [id], onDelete: Cascade)
  sharedWith                   User[]                   @relation("questionsSharedWith")
  sharedWithLists              UserList[]
  sharedPublicly               Boolean                  @default(false)
  unlisted                     Boolean                  @default(true)
  questionScores               QuestionScore[]
  questionMessages             QuestionSlackMessage[]
  resolutionMessages           ResolutionSlackMessage[]
  comments                     Comment[]
  tags                         Tag[]
  tournaments                  Tournament[]
  exclusiveAnswers             Boolean?                 @default(true)
  notifications                Notification[]
  oracleKind                   PredictionOracleKind     @default(PUBLIC_FACT)
  provenance                   RecordProvenance         @default(HUMAN)
  // 结算判据：可证伪、在决策时冻结（ADR-0002）；自评类必须同时冻结评分锚点
  resolutionCriteria           String?
  scoringAnchor                String?
  // 结算证据（ADR-0004）：自行结算与提案被采纳时写入，使「可核查来源」可结构化检索
  resolutionSource             String?
  resolutionRationale          String?
  // 谁确认的这次结算（ADR-0031 §三）。生效范围的判据依赖它：没有可核查来源时，
  // 只有确认者本人的 Forecast 计入计量（§六）。只存标识、不建外键——与
  // `agentSessionId` 同为审计标识，而不是参与业务读取的关系。
  confirmedByUserId            String?
  revisions                    Revision[]
  proposals                    ResolutionProposal[]
  // ADR-0019：Prediction 归属 Decision，至多一个；删容器不删预测（SetNull）
  decisionId                   String?
  decision                     Decision?                @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  // 审计线索（ADR-0027）：发起方类别 + 会话标识，只存标识不存正文
  initiator                    InitiatorKind            @default(HUMAN)
  agentSessionId               String?

  @@index([decisionId])
}

model Tag {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  // 显示保留用户写下的原样（`投资/宏观/CPI`），但**判重折叠大小写**：
  // 库里原本是 `@@unique([name, userId])`（大小写敏感），`CPI` 与 `cpi` 会裂成两个桶，
  // 而这类错误是静默的（Obsidian 也把二者当同一个标签）。
  name           String
  nameNormalized String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions      Question[]
  decisions      Decision[]
  userId         String

  @@unique([nameNormalized, userId])
}

model ResolutionSlackMessage {
  id         Int          @id @default(autoincrement())
  questionId String
  detailsId  Int          @unique
  profileId  Int?
  message    SlackMessage @relation(fields: [detailsId], references: [id], onDelete: Cascade)
  profile    Profile?     @relation(fields: [profileId], references: [id])
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model PingSlackMessage {
  id         Int          @id @default(autoincrement())
  questionId String
  detailsId  Int          @unique
  message    SlackMessage @relation(fields: [detailsId], references: [id], onDelete: Cascade)
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionSlackMessage {
  id         Int          @id @default(autoincrement())
  questionId String
  detailsId  Int          @unique
  updatedAt  DateTime     @default(now())
  message    SlackMessage @relation(fields: [detailsId], references: [id], onDelete: Cascade)
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model SlackMessage {
  id                     Int                     @id @default(autoincrement())
  ts                     String
  channel                String
  teamId                 String
  pingSlackMessage       PingSlackMessage?
  questionSlackMessage   QuestionSlackMessage?
  resolutionSlackMessage ResolutionSlackMessage?
}

model User {
  id                       String           @id @default(cuid())
  name                     String?
  createdAt                DateTime         @default(now())
  email                    String           @unique
  image                    String?
  forecasts                Forecast[]
  profiles                 Profile[]
  questions                Question[]       @relation("author")
  questionScores           QuestionScore[]
  questionsSharedWith      Question[]       @relation("questionsSharedWith")
  comments                 Comment[]
  target                   Target?          @relation("userTarget")
  authorOfLists            UserList[]       @relation(name: "author")
  memberOfLists            UserList[]       @relation(name: "members")
  staleReminder            Boolean          @default(true)
  unsubscribedFromEmailsAt DateTime?
  apiKey                   String?
  discordUserId            String?          @unique
  tags                     Tag[]
  tournaments              Tournament[]
  notifications            Notification[]
  questionOptions          QuestionOption[] @relation("author")
  decisions                Decision[]
  pairingCodes             PairingCode[]

  // Used by next-auth:
  emailVerified DateTime?
  accounts      Account[]
}

model Profile {
  id                 Int                      @id @default(autoincrement())
  createdAt          DateTime                 @default(now())
  slackId            String?
  slackTeamId        String?
  userId             String
  forecasts          Forecast[]
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions          Question[]
  resolutionMessages ResolutionSlackMessage[]
  target             Target?                  @relation("profileTarget")
}

model Group {
  id          Int       @id @default(autoincrement())
  type        GroupType
  createdAt   DateTime  @default(now())
  name        String    @db.VarChar(255)
  slackTeamId String?
}

model Target {
  id           Int          @id @default(autoincrement())
  user         User         @relation("userTarget", onDelete: Cascade, fields: [userId], references: [id])
  userId       String       @unique
  profile      Profile?     @relation("profileTarget", fields: [profileId], references: [id], onDelete: Cascade)
  profileId    Int?         @unique
  type         TargetType
  goal         Int
  lastFailedAt DateTime     @default(now())
  notifyOn     DayOfTheWeek
  lastNotified DateTime     @default(now())
}

enum DayOfTheWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TargetType {
  FORECAST
  QUESTION
}

enum GroupType {
  WEB
  SLACK
}

enum Resolution {
  YES
  NO
  AMBIGUOUS
}

// 结算判据的类型，决定跟踪 Agent 的权限层级
enum PredictionOracleKind {
  PUBLIC_FACT
  AGENT_OBSERVABLE
  SELF_REPORT
}

// 记录的录入来源（ADR-0008 要求区分「自主搜集」与「依据人的明确指令」）
enum RecordProvenance {
  HUMAN
  AGENT
  AGENT_INSTRUCTED
}

/// 发起方类别（ADR-0027）：这次调用来自身边的人，还是 agent 代跑。
///
/// 与 `RecordProvenance` 是两件事，分开存：数字可能是 agent 发起的会话里由当事人
/// 亲口给的（`initiator = AGENT` + `provenance = HUMAN`）——那不是缺陷，但它必须
/// 可以被筛出来复查，否则 ADR-0024 的默认方向就只是一次不可核查的自我申报。
enum InitiatorKind {
  HUMAN
  AGENT
}

// 待触达状态机
enum DeliveryState {
  PENDING
  DELIVERED
  NOT_NEEDED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// OAuth account, e.g. google - used by next-auth for web
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Comment {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  comment    String
  questionId String
  userId     String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserList {
  id                   String       @id @default(cuid())
  createdAt            DateTime     @default(now())
  inviteId             String?      @unique @default(cuid())
  name                 String
  emailDomains         String[]
  syncToSlackTeamId    String?
  syncToSlackChannelId String?
  authorId             String
  author               User         @relation(name: "author", fields: [authorId], references: [id], onDelete: Cascade)
  users                User[]       @relation(name: "members")
  questions            Question[]
  tournaments          Tournament[]
}

model Tournament {
  id                   String     @id @default(cuid())
  createdAt            DateTime   @default(now())
  name                 String
  description          String?
  questions            Question[]
  authorId             String
  author               User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sharedPublicly       Boolean    @default(false)
  unlisted             Boolean    @default(true)
  userList             UserList?  @relation(fields: [userListId], references: [id], onDelete: Cascade)
  userListId           String?
  anyoneInListCanEdit  Boolean    @default(false)
  showLeaderboard      Boolean    @default(true)
  predictYourYear      Int?
  syncToSlackTeamId    String?
  syncToSlackChannelId String?
}

model Notification {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  emailSentAt   DateTime?
  title         String
  content       String
  url           String?
  tags          String[]
  read          Boolean       @default(false)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String?
  question      Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  deliveryState DeliveryState @default(PENDING)
  deliveredAt   DateTime?
  deliveredVia  String?

  @@index([userId, deliveryState])
}

// 对已冻结字段（判据 / 期限 / 锚点）的修改留痕。首次 Forecast 之前
// 的改动不算修订，因此不在本表留记录。
//
// ADR-0012 的同一机制后也承载 **Decision 叙事字段**的改写（ADR-0020）：主体
// 既可能是 Question 也可能是 Decision，用 `questionId` / `decisionId` 二者恰有
// 其一表达——这条"恰有其一"由迁移里的 CHECK 约束强制（Prisma schema 表达不了）。
model Revision {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  decisionId String?
  decision   Decision? @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  field      String
  oldValue   String?
  newValue   String?
  reason     String?

  @@index([questionId])
  @@index([decisionId])
}

// 跟踪 Agent 提出的结算建议。公共事实类若无来源则不得直接结算，
// 只能落入本表等待当事人确认。
model ResolutionProposal {
  id         String         @id @default(cuid())
  createdAt  DateTime       @default(now())
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  resolution Resolution
  source     String?
  rationale  String?
  proposedBy String         @default("agent")
  status     ProposalStatus @default(PENDING)
  decidedAt  DateTime?

  @@index([questionId])
  @@index([status])
}

model Feedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String
  message   String
  email     String?
  userId    String?
}

// Used by next-auth for email verification
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// 一次决策（ADR-0001 / ADR-0019）。承载决策时点的推理过程，并包含 0..n 个
// Prediction（复用 Question/Forecast）。叙事字段不参与任何评分。
model Decision {
  id              String                   @id @default(cuid())
  createdAt       DateTime                 @default(now())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement       String                   @db.Text
  reasoning       String?                  @db.Text
  expectedOutcome String?                  @db.Text
  knownInfo       String?                  @db.Text
  unknownInfo     String?                  @db.Text
  // ADR-0037：同一判据现在管两样东西——该决策下任一 Prediction 结算后**清单只读、
  // 叙事冻结**，锁定即写时间（不回退）。字段名不叫 rubricLockedAt，因为它不只管清单，
  // 而且写入的是"观察到的时点"（通常略晚于 resolvedAt），不是揭晓时点本身。
  lockedAt        DateTime?
  // ADR-0020 第四点：该决策计分时适用的清单条目集合版本。条目增删只能新建版本，
  // 既有版本的条目列表不得改写——历史决策因此按自己的版本解释。
  rubricVersion   Int                      @default(1)
  // ADR-0020 第六点：清单写在"结果揭晓之后"的时点标记。只在对一条**已结算**的
  // Prediction 做挂载时写下，且只写一次——那条路径是唯一能绕过锁定的绕道。
  rubricRecordedAfterOutcomeAt DateTime?
  // ADR-0041：决策动作（承诺半边）。它属于"当初的记录"，因此改写须留痕、
  // 揭晓后与叙事一同冻结（同一个 decisionLockOf）。
  action          String?                  @db.Text
  actionDueAt     DateTime?
  questions       Question[]
  rubricEntries   DecisionRubricEntry[]
  // 领域权威在 Decision（ADR-0030）：用户在这里表达一次"这条决策属于哪个领域"，
  // 挂接预测时写时复制为其 Question 的标签，且事后不跟随。
  tags            Tag[]
  // 叙事字段的改写留痕（ADR-0012）：旧值 / 新值 / 时间 / 理由
  revisions       Revision[]
  // 事后表达通道（ADR-0037）：与叙事字段物理分开、只增不改，因此不必读时间戳
  // 就知道它是"现在怎么看"而不是"当时怎么想"。
  reflections     DecisionReflection[]
  // ADR-0041：执行事实（只增不改、不冻结——多阶段执行可能晚于揭晓）
  executions      DecisionExecution[]

  @@index([userId])
}

// 清单完成情况，每条一行（ADR-0016 要求记录每条而非只存总分）。
model DecisionRubricEntry {
  id         String           @id @default(cuid())
  decisionId String
  decision   Decision         @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  // ADR-0020：存稳定标识而非文案——文案改写不改写历史语义
  itemKey    String
  status     RubricItemStatus
  recordedAt DateTime         @default(now())

  @@unique([decisionId, itemKey])
  @@index([decisionId])
}

/// 事后表达（ADR-0037）：**只增不改、不可删**。每条自带时点，因此不必读时间戳
/// 就知道它是事后的；不给 `updatedAt`——那会暗示可改，而"后来的复盘盖掉前面的
/// 复盘"正是这条 ADR 要堵的无声改写。
model DecisionReflection {
  id         String   @id @default(cuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([decisionId])
}

/// 执行事实（ADR-0041）：**只增不改**。一次决策可以有多次执行事件（多阶段执行），
/// 因此它是一张表而不是几个时点字段。`ABANDONED` 是独立取值——否则"明确放弃"
/// 会被永久读成"逾期未做"。
model DecisionExecution {
  id         String        @id @default(cuid())
  decisionId String
  decision   Decision      @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  kind       ExecutionKind
  /// 事实发生的时点（可回填：先做事后记录是常态）
  occurredAt DateTime      @default(now())
  note       String?       @db.Text
  createdAt  DateTime      @default(now())

  @@index([decisionId])
}

enum ExecutionKind {
  EXECUTED
  ABANDONED
}

// ADR-0020：只有二值，没有"不适用"——那是个自我开脱的口子。
enum RubricItemStatus {
  DONE
  NOT_DONE
}

/// 一次性配对码（ADR-0035）：由**持有该身份凭据**的一方签发，在实例本机把它换成
/// 该身份的网页会话。三条性质由字段本身表达，不靠约定：
/// 一次有效 = `usedAt`，短时效 = `expiresAt`，不落明文 = `codeHash`。
model PairingCode {
  id        String    @id @default(cuid())
  /// 归一化后码的 sha256（明文只在签发那一刻打印，之后无处可查）
  codeHash  String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}
